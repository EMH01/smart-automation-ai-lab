# Configuration only: no API keys or secrets
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=hr-knowledge
AZURE_SEARCH_MODE=keyword
# Enable only after provisioning a separate index with integrated vectorizer:
AZURE_SEARCH_VECTOR_INDEX=hr-knowledge-vector
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_FOUNDRY_ENDPOINT=https://<your-foundry>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_DEPLOYMENT=<your-chat-model-deployment>
